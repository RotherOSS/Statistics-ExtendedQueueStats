<?xml version="1.0" encoding="utf-8" ?>
<otobo_package version="1.0">
    <Name>OTOBOExtendedTicketStats</Name>
    <Version>0.0.0</Version>
    <Framework Minimum="10.1.0">10.1.x</Framework>
    <Vendor>Rother OSS GmbH</Vendor>
    <URL>https://otobo.io/</URL>
    <License>GNU GENERAL PUBLIC LICENSE Version 3, 29 June 2007</License>
    <Description Lang="en">The ExtendedTicketStats package.</Description>
    <Description Lang="de">Das ExtendedTicketStats Paket.</Description>
    <Description Lang="hu">A kiterjesztett jegystatisztikák csomag.</Description>
    <Filelist>
        <File Permission="660" Location="Kernel/Config/Files/XML/OTOBOExtendedTicketStats.xml" />
        <File Permission="660" Location="Kernel/Language/de_OTOBOExtendedTicketStats.pm" />
        <File Permission="660" Location="Kernel/Language/hu_OTOBOExtendedTicketStats.pm" />
        <File Permission="660" Location="Kernel/System/Stats/Dynamic/OTOBOStatsQueueRestingTime.pm" />
        <File Permission="660" Location="Kernel/System/Stats/Dynamic/OTOBOStatsQueueWorkingTime.pm" />
        <File Permission="660" Location="Kernel/System/Stats/Static/OTOBOStatsResponseStatistic.pm" />
        <File Permission="660" Location="doc/en/OTRSExtendedTicketStats.pdf" />
        <File Permission="660" Location="scripts/test/OTOBOStatsQueueRestingTime.t" />
        <File Permission="660" Location="scripts/test/OTOBOStatsQueueWorkingTime.t" />
        <File Permission="660" Location="scripts/test/OTOBOStatsResponseStatistic.t" />
        <File Permission="660" Location="var/packagesetup/OTOBOExtendedTicketStats.pm" />
        <File Permission="660" Location="var/stats/OTOBOStats-ResponseStatistic.xml" />
    </Filelist>
    <CodeInstall Type="post"><![CDATA[

        # create the package name
        my $CodeModule = 'var::packagesetup::' . $Param{Structure}->{Name}->{Content};

        $Kernel::OM->Get($CodeModule)->CodeInstall();
    ]]></CodeInstall>
    <CodeUpgrade Type="post"><![CDATA[

        # create the package name
        my $CodeModule = 'var::packagesetup::' . $Param{Structure}->{Name}->{Content};

        $Kernel::OM->Get($CodeModule)->CodeUpgrade();
    ]]></CodeUpgrade>
    <CodeUninstall Type="pre"><![CDATA[

        # create the package name
        my $CodeModule = 'var::packagesetup::' . $Param{Structure}->{Name}->{Content};

        $Kernel::OM->Get($CodeModule)->CodeUninstall();
    ]]></CodeUninstall>
    <CodeReinstall Type="post"><![CDATA[

        # create the package name
        my $CodeModule = 'var::packagesetup::' . $Param{Structure}->{Name}->{Content};

        $Kernel::OM->Get($CodeModule)->CodeReinstall();
    ]]></CodeReinstall>
    <PackageMerge Name="OTRSStatsResponseStatistic" TargetVersion="1.3.3"></PackageMerge>
