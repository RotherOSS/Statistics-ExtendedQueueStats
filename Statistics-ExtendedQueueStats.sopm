    <Filelist>
        <File Permission="660" Location="Kernel/Config/Files/XML/Statistics-ExtendedQueueStats.xml" />
        <File Permission="660" Location="Kernel/Language/de_StatisticsExtendedQueueStats.pm" />
        <File Permission="660" Location="Kernel/Language/hu_StatisticsExtendedQueueStats.pm" />
        <File Permission="660" Location="Kernel/System/Stats/Dynamic/QueueRestingTime.pm" />
